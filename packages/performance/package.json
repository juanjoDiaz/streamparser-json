{
  "name": "@streamparser/json-performance",
  "version": "0.0.22",
  "description": "Performance benchmarks for streamparser-json, comparing the core parser and its Node/WHATWG stream adapters",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "benchmark": "node throughput/run.mjs",
    "benchmark:strings": "node string-builder/node.mjs",
    "benchmark:strings:browsers": "node string-builder/browser.mjs",
    "benchmark:strings:crossover": "node string-crossover/run.mjs",
    "benchmark:strings:multibyte": "node string-span/run.mjs"
  },
  "dependencies": {
    "@streamparser/json": "*",
    "@streamparser/json-node": "*",
    "@streamparser/json-whatwg": "*"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
